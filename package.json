{
  "name": "rlm-sh",
  "version": "0.1.0",
  "description": "Self-evolving terminal agent \u2014 JavaScript-native, Cordis plugins, hot-reloadable everything, recursive subagents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rlm": "cordis-shell.mjs"
  },
  "files": [
    "cordis-shell.mjs",
    "cordis.yml",
    "tsconfig.json",
    "tsconfig.base.json",
    "packages/*/src/**/*",
    "packages/*/last-good/**/*",
    "packages/*/package.json",
    "packages/*/README.md",
    "packages/*/CHANGELOG.md",
    "packages/*/docs/**/*",
    "packages/*/skills/**/*",
    "packages/*/bin/**/*",
    "packages/*/workflows/**/*",
    "packages/*/tools/**/*",
    "packages/*/rubrics/**/*",
    "packages/*/calibration/**/*",
    "assets/**/*",
    "docs/**/*",
    "install.sh"
  ],
  "workspaces": [
    "packages/tui",
    "packages/ai",
    "packages/agent",
    "packages/coding-agent",
    "packages/rlm-*"
  ],
  "scripts": {
    "build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../coding-agent && npm run build",
    "dev": "node cordis-shell.mjs",
    "skills:check": "node --import tsx scripts/check-skills.ts",
    "test:skills-gate": "node --import tsx --test scripts/check-skills.test.ts",
    "check:types": "bunx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-bedrock-runtime": "^3.1095.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.17",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.4",
    "@google/genai": "^1.40.0",
    "@mistralai/mistralai": "^2.2.0",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@types/mime-types": "^3.0.1",
    "acorn": "^8.18.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "file-type": "^21.1.1",
    "get-east-asian-width": "^1.6.0",
    "glob": "^13.0.1",
    "hosted-git-info": "^9.0.2",
    "ignore": "^7.0.5",
    "jiti": "^2.7.0",
    "js-yaml": "^4",
    "marked": "^18.0.7",
    "mime-types": "^3.0.1",
    "minimatch": "^10.2.3",
    "openai": "6.47.0",
    "partial-json": "^0.1.7",
    "proper-lockfile": "^4.1.2",
    "proxy-agent": "^6.5.0",
    "strip-ansi": "^7.1.0",
    "tsx": "^4.23.12",
    "typebox": "^1.3.9",
    "undici": "^7.29.0",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0",
    "zeromq": "^6.1.2",
    "zod-to-json-schema": "^3.24.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishakenp/rlm.git"
  },
  "homepage": "https://github.com/abhishakenp/rlm#readme",
  "bugs": "https://github.com/abhishakenp/rlm/issues",
  "keywords": [
    "ai-agent",
    "cli",
    "llm",
    "terminal",
    "tui",
    "cordis",
    "self-evolving",
    "subagents",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22.8.0"
  }
}